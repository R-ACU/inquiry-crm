# Copy to .env.local for local work. Never commit real values.

# Supabase project: Project Settings > API.
# Only the publishable (anon) key is needed. The app never uses a service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the app. Used for links in calendar files; https enables Secure cookies.
APP_URL=http://127.0.0.1:3210

# AI assistant: "mock" (default, fixed answers from fixtures/) or "anthropic" (real Claude API calls, costs money).
AI_MODE=mock

# Only for AI_MODE=anthropic. Keep it in .env.local, never in the shell profile or the repo.
ANTHROPIC_API_KEY=
